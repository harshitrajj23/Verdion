{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "VerdionEvidence",
  "type": "object",
  "required": ["id", "document_id", "passage_reference", "content", "digest", "source_metadata", "retrieved_at"],
  "properties": {
    "id": { "type": "string", "pattern": "^evi_[a-zA-Z0-9_-]+$" },
    "document_id": { "type": "string" },
    "passage_reference": { "type": "string" },
    "content": { "type": "string", "minLength": 10 },
    "digest": { "type": "string", "pattern": "^0x[a-fA-F0-9]{64}$" },
    "source_metadata": {
      "type": "object",
      "required": ["title", "authority", "jurisdiction", "effective_date"],
      "properties": {
        "title": { "type": "string" },
        "authority": { "type": "string" },
        "jurisdiction": { "type": "string" },
        "url": { "type": "string" },
        "publication_date": { "type": "string" },
        "effective_date": { "type": "string" },
        "is_superseded": { "type": "boolean" },
        "superseded_by": { "type": "string" }
      }
    },
    "provenance_signature": { "type": "string" },
    "retrieved_at": { "type": "string", "format": "date-time" }
  }
}
